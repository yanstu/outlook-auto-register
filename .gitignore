# ═══════════════════════════════════════════════════════
# 敏感配置（含 captcha key、代理密码、CF Worker token）
# ═══════════════════════════════════════════════════════
.env
*.env
!.env.example

# 38 服务器部署凭据（SSH 密码、运维台口令、Mailbox API admin key）
.deploy/local.env

# ═══════════════════════════════════════════════════════
# 生成的账号数据（含 email/password/refresh_token，敏感）
# ═══════════════════════════════════════════════════════
accounts/
*.txt.bak
accounts_recovery.txt

# ═══════════════════════════════════════════════════════
# 运行日志（含 token、调试输出）
# ═══════════════════════════════════════════════════════
logs/
*.log
*.out

# ═══════════════════════════════════════════════════════
# 调试产物（截图 / 页面 dump / HTML 快照）
# ═══════════════════════════════════════════════════════
debug_browser_oauth/
debug_oauth/
debug_rescue_shots/
*.png
*.json.bak

# 例外：保留 docs / webapp/static / README 截图
!webapp/static/index.html
!docs/
!assets/screenshots/
!assets/screenshots/**

