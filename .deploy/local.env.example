# 38 服务器部署凭据。复制成同目录的 local.env 后填真值：
#   cp .deploy/local.env.example .deploy/local.env && chmod 600 .deploy/local.env
# local.env 已被 .gitignore 忽略，绝不入库，也不要贴进对话或提交信息。
#
# scripts/deploy_to_38.sh 启动时自动 source 本目录的 local.env，无需手动 export。

# SSH 目标，形如 user@host。留空时脚本回退到 root@38.76.160.89。
OUTLOOK_DEPLOY_HOST=root@38.76.160.89

# SSH 密码。填了就走 sshpass；留空则用 ~/.ssh 里的密钥登录。
OUTLOOK_DEPLOY_PASSWORD=

# 对外域名。
OUTLOOK_DOMAIN=outlook.coolhs.com

# 运维台登录口令（浏览器 /login.html，或 curl 的 X-Console-Password 头）。
# 不能留空：服务挂在公网域名上，空口令等于把账号库摆在门口，脚本会直接拒绝部署。
OUTLOOK_CONSOLE_PASSWORD=

# Mailbox API 的 admin key（scopes=admin,*），给其他项目建 key 用。
# 32 字符以上的随机串，例如：python3 -c 'import secrets;print("mbxadmin_"+secrets.token_urlsafe(32))'
# 留空时脚本沿用远端 .env 里已有的那枚；远端也没有就现场生成一枚。
OUTLOOK_MAILBOX_API_ADMIN_KEY=

# 只更新应用、不动 nginx / 证书时设为 1。
# OUTLOOK_SKIP_NGINX=0
