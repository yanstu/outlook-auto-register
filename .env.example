# PerimeterX 打码（优先级：captcha.run > CapSolver > EzCaptcha）
CAPTCHA_RUN_API_KEY=
CAPTCHA_RUN_API_BASE=https://apicn.captcha.run
EZCAPTCHA_API_KEY=
EZCAPTCHA_API_BASE=https://api.ez-captcha.com
CAPSOLVER_API_KEY=

# 代理：Web 控制台请用「代理池」页或注册页填写（自动写入 SQLite），勿依赖本项
# CLI / 脚本仍可读 HTTP_PROXY
HTTP_PROXY=
# HTTP_PROXY_POOL=  # 已废弃，请用 Web 代理池（accounts/outlook.db）

# 可选：自定义 SQLite 路径（账号 + 代理池 + 批次 + 元数据统一库）
# OUTLOOK_DB_PATH=accounts/outlook.db

# 新号孵化时长（小时）。孵化期内批量测活 / 定时保活跳过，不打微软接口。默认 48
# OUTLOOK_INCUBATION_HOURS=48

# ── Mailbox API v1（/api/v1，给其他项目收信、取码、查字段）见 docs/MAILBOX_API.md ──
# 1=挂载 /api/v1 路由（默认）；0=只留运维台
OUTLOOK_MAILBOX_API_ENABLED=1
# 首次启动写入的 admin key（scopes=admin,*）。留空则只能用
# scripts/mailbox_api_key.py create 建 key
OUTLOOK_MAILBOX_API_ADMIN_KEY=
# 用户端登录会话有效期（小时），默认 24
OUTLOOK_MAILBOX_API_SESSION_HOURS=24

# ── proofs 恢复邮箱收码后端（六段活号需绑定恢复邮箱）─────────────────────────
# imap（默认） : 第三方 IMAP 恢复邮箱池（每行 email----password），账密登 IMAP 读微软 OTT
# cf_domain    : Cloudflare 域名 catch-all 邮箱——按需生成随机 xxxx@域名，
#                微软发码后经自建 CF Worker 临时邮服 API 读码（无需预置账密）
# coolhs_mail  : 自建 coolhs-mail（hook.coolhs.com）——按需生成 @mail.coolhs.com，
#                经 x-api-token + /api/mailbox/... 收码
OUTLOOK_RECOVERY_BACKEND=imap

# —— imap 后端 —— #
OUTLOOK_EXTERNAL_RECOVERY_POOL_FILE=
OUTLOOK_RECOVERY_IMAP_HOST=imap.your-recovery-host.com
OUTLOOK_RECOVERY_IMAP_PORT=993

# —— coolhs_mail 后端（hook.coolhs.com）—— #
COOLHS_MAIL_BASE_URL=https://hook.coolhs.com
COOLHS_MAIL_API_TOKEN=
COOLHS_MAIL_DOMAIN=mail.coolhs.com
# COOLHS_MAIL_PREFIX_LEN=12
# COOLHS_MAIL_RECOVERY_PLACEHOLDER=coolhs_mail
# COOLHS_MAIL_USE_CREATE_API=1
# COOLHS_MAIL_VERIFY_SSL=1

# —— cf_domain 后端（Cloudflare 域名 catch-all + CF Worker 临时邮服）—— #
# 域名（catch-all 已在 Cloudflare Email Routing 开启）
OUTLOOK_CF_DOMAIN=your-domain.com
# CF Worker API 根（apimail 子域，非 mail.*/admin 网页地址）
OUTLOOK_CF_WORKER_API_URL=https://apimail.your-domain.com
# CF Worker 管理员密码（x-admin-auth）—— 敏感，勿提交
OUTLOOK_CF_WORKER_ADMIN_TOKEN=
# 可选：catch-all 转发到单一中转箱的拓扑，用它兜底按 alias 过滤
OUTLOOK_CF_FORWARD_EMAIL=
# 随机前缀长度（默认 12）
OUTLOOK_CF_PREFIX_LEN=12
# 0=随机 catch-all 地址(默认，无需注册)；1=调 CF Worker /admin/new_address 注册地址
OUTLOOK_CF_USE_NEW_ADDRESS=0
# 证书校验（默认 1；自签边缘可设 0）
OUTLOOK_CF_VERIFY_SSL=1
# 六段 combo 第 6 段占位（CF 恢复邮箱无账密），默认 cf_domain
OUTLOOK_CF_RECOVERY_PLACEHOLDER=cf_domain
# 收信拉取条数：alias 专用地址默认 50；共用中转箱较繁忙，默认多拉 100 兜住最新一封
OUTLOOK_CF_MAIL_LIMIT=50
OUTLOOK_CF_FORWARD_LIMIT=100
